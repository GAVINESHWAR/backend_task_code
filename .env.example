DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/productivity_os
# Optional: separate URL for the db/*.sql auto-runner. Leave empty to reuse DATABASE_URL.
SYNC_DATABASE_URL=
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# IMPORTANT (split deploy): add your frontend URL here, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_RUN_SQL=true
# PORT is set by the host (Render/Railway/...). Only needed locally if 8000 is taken.
PORT=8000
